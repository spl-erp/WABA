   "label": "Send documents (quotations, invoices)",
   "default": "1"
  },
  {
   "fieldname": "purpose_notifications",
   "fieldtype": "Check",
   "label": "Notifications and reminders",
   "default": "1"
  },
  {
   "fieldname": "purpose_campaigns",
   "fieldtype": "Check",
   "label": "Campaigns",
   "default": "0"
  },
  {
   "fieldname": "reply_policy",
