 "fields": [
  {
   "fieldname": "account",
   "fieldtype": "Link",
   "label": "Account",
   "options": "Waba Account",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "display_number",
   "fieldtype": "Data",
   "label": "Number",
   "reqd": 1,
   "in_list_view": 1,
   "description": "International format. Stored as +<digits>; it is the record's ID."
  },
  {
   "fieldname": "display_name",
   "fieldtype": "Data",
   "label": "Display name",
   "in_list_view": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1"
  },
  {
   "fieldname": "receive_only",
   "fieldtype": "Check",
   "label": "Receive only (safety)",
   "default": "0",
   "in_list_view": 0,
   "description": "Tick on a live number that the ERP only listens to. Nothing can be sent from it, not even read receipts, so a test cannot reach real customers."
  },
  {
   "fieldname": "column_break_nu1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "phone_number_id",
   "fieldtype": "Data",
   "label": "Phone number ID (Meta)",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "name_status",
   "fieldtype": "Data",
   "label": "Display name status",
   "read_only": 1
  },
  {
   "fieldname": "quality_rating",
   "fieldtype": "Select",
   "label": "Quality rating",
   "options": "\nGREEN\nYELLOW\nRED\nUNKNOWN",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Data",
   "label": "Status",
   "read_only": 1
  },
  {
   "fieldname": "registration_section",
   "fieldtype": "Section Break",
   "label": "Registration with Meta",
   "description": "Use the buttons at the top of this form (Registration). Nothing here is sent as a message and nothing is charged."
  },
  {
   "fieldname": "code_verification_status",
   "fieldtype": "Data",
   "label": "Verification",
   "read_only": 1
  },
  {
   "fieldname": "registered_at",
   "fieldtype": "Datetime",
   "label": "Registered here on",
   "read_only": 1
  },
  {
   "fieldname": "column_break_nu5",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "registration_pin",
   "fieldtype": "Password",
   "label": "Two-step PIN (kept encrypted)",
   "description": "The 6-digit PIN chosen when registering. Only filled when you ticked \"Save the PIN\". Meta needs it to change or delete this number."
  },
  {
   "fieldname": "registration_note",
   "fieldtype": "Small Text",
   "label": "Registration note",
   "read_only": 1
  },
  {
   "fieldname": "coexistence_section",
   "fieldtype": "Section Break",
   "label": "WhatsApp Business app (coexistence)"
  },
  {
   "fieldname": "coexistence",
   "fieldtype": "Check",
   "label": "Also used in the WhatsApp Business app",
   "default": "0",
   "description": "Tick only for a number Meta connected to the API while keeping it in the WhatsApp Business app (coexistence). What the team types in the phone app then appears here as \"Phone app\" messages. The registration buttons are switched off for such a number: registering it would cut the phone app link."
  },
  {
   "fieldname": "coexistence_state",
   "fieldtype": "Select",
   "label": "Phone app link",
   "options": "\nConnected\nDisconnected\nOffboarded",
   "read_only": 1,
   "depends_on": "coexistence",
   "description": "Kept up to date from Meta's account updates. Disconnected: the phone app was not opened for about 14 days or the link was cut. Sending from Waba pauses until it is reconnected."
  },
  {
   "fieldname": "coexistence_at",
   "fieldtype": "Datetime",
   "label": "Link last changed",
   "read_only": 1,
   "depends_on": "coexistence"
  },
  {
   "fieldname": "use_section",
   "fieldtype": "Section Break",
   "label": "How this number is used"
  },
  {
   "fieldname": "number_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Shared\nPersonal",
   "default": "Shared",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Shared: a team or region. Personal: assigned to one agent (a company number, not their own)."
  },
  {
   "fieldname": "owner_user",
   "fieldtype": "Link",
   "label": "Owner (Personal numbers)",
   "options": "User",
   "depends_on": "eval:doc.number_type==\"Personal\"",
   "mandatory_depends_on": "eval:doc.number_type==\"Personal\""
  },
  {
   "fieldname": "team",
   "fieldtype": "Data",
   "label": "Team or region (not used)",
