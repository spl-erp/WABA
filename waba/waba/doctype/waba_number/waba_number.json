  },
  {
   "fieldname": "hours_section",
   "fieldtype": "Section Break",
   "label": "Business hours"
  },
  {
   "fieldname": "hours_enabled",
   "fieldtype": "Check",
   "label": "Use business hours"
  },
  {
   "fieldname": "hours_start",
   "fieldtype": "Time",
   "label": "From",
   "depends_on": "hours_enabled"
  },
  {
   "fieldname": "hours_end",
   "fieldtype": "Time",
   "label": "To",
   "depends_on": "hours_enabled"
  },
  {
   "fieldname": "working_days",
   "fieldtype": "Data",
   "label": "Working days",
   "default": "Mon,Tue,Wed,Thu,Fri,Sat",
